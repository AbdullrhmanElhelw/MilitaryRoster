@model List<MilitaryRoster.ViewModels.RosterItemViewModel>

@{
    ViewData["Title"] = "تسجيل عودة واستلام الموظفين";
    var availableTypes = ViewBag.AvailableTypes as List<MilitaryRoster.Models.Entities.SoldierType> ?? new();
    string search = ViewBag.Search as string ?? "";
    int? selectedTypeId = ViewBag.SoldierTypeId as int?;
    string statusFilter = ViewBag.StatusFilter as string ?? "";
}

<div class="space-y-6">
    
    <!-- بطاقة الرأس والتعليمات الرسمية -->
    <div class="bg-white border border-slate-200 p-5 rounded-2xl shadow-xl flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 flex items-center justify-center">
                <img src="/images/logo.png" alt="شعار المنظومة" class="w-full h-full object-contain filter drop-shadow" />
            </div>
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <h1 class="text-base sm:text-lg font-black text-[#0d1f36]">تسجيل عودة واستلام الموظفين (تمام الوصول)</h1>
                    <span class="px-2.5 py-0.5 rounded-full bg-blue-500/20 text-blue-700 text-[11px] font-mono font-bold border border-blue-500/30">
                        @Model.Count موظف
                    </span>
                </div>
                <p class="text-xs text-amber-600 font-bold">
                    المنظومة — تثبيت استلام الخدمة وبدء عداد الـ 10 أيام من اليوم التالي تلقائياً
                </p>
            </div>
        </div>

        <div class="flex items-center gap-2">
            <a href="/Roster" class="px-4 py-2 rounded-xl text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 border border-slate-300 transition-colors flex items-center gap-1.5">
                <span> كشف الجداول</span>
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-700 text-xs font-bold flex items-center gap-2 shadow-lg">
            <svg class="w-5 h-5 text-emerald-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-700 text-xs font-bold flex items-center gap-2 shadow-lg">
            <svg class="w-5 h-5 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- شريط البحث والتصفية السريعة -->
    <div class="bg-white border border-slate-200 p-4 rounded-2xl shadow-xl flex flex-col md:flex-row items-center justify-between gap-3">
        <form method="get" action="/ReturnManagement" class="flex flex-wrap items-center gap-2.5 w-full md:w-auto">
            <!-- البحث بالاسم -->
            <div class="relative min-w-[240px]">
                <input type="text"
                       name="search"
                       value="@search"
                       placeholder="بحث باسم الموظف أو رقم الموظف..."
                       class="w-full pl-3 pr-9 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs text-[#0d1f36] placeholder-slate-500 focus:border-amber-500 focus:outline-none" />
                <svg class="w-4 h-4 text-slate-500 absolute right-3 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
            </div>

            <!-- التصفية بالنوع -->
            <select name="soldierTypeId" onchange="this.form.submit()"
                    class="px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs text-slate-800 focus:border-amber-500 focus:outline-none">
                <option value="">جميع فئات الموظفين</option>
                @foreach (var t in availableTypes)
                {
                    <option value="@t.Id" selected="@(selectedTypeId == t.Id ? "selected" : null)">@t.Name</option>
                }
            </select>

            <button type="submit" class="px-4 py-2 rounded-xl text-xs font-bold text-[#0d1f36] bg-[#205493] text-white hover:bg-[#1f4e79] transition-colors">
                تطبيق
            </button>
            @if (!string.IsNullOrWhiteSpace(search) || selectedTypeId.HasValue || !string.IsNullOrWhiteSpace(statusFilter))
            {
                <a href="/ReturnManagement" class="px-3 py-2 rounded-xl text-xs text-slate-500 hover:text-[#0d1f36] bg-slate-100">
                    إعادة ضبط
                </a>
            }
        </form>

        <!-- أزرار الحالة السريعة -->
        <div class="flex items-center gap-1.5 text-xs">
            <a href="/ReturnManagement" class="px-3 py-1.5 rounded-lg font-bold transition-all @(string.IsNullOrEmpty(statusFilter) ? "bg-[#205493] text-white text-[#0d1f36] shadow" : "text-slate-500 hover:text-[#0d1f36] bg-slate-50 border border-slate-200")">
                الكل (@Model.Count)
            </a>
            <a href="/ReturnManagement?statusFilter=returnToday" class="px-3 py-1.5 rounded-lg font-bold transition-all @(statusFilter == "returnToday" ? "bg-blue-600 text-white text-[#0d1f36] shadow" : "text-blue-700/80 hover:text-blue-700 bg-slate-50 border border-slate-200")">
                 عودة اليوم
            </a>
            <a href="/ReturnManagement?statusFilter=overdue" class="px-3 py-1.5 rounded-lg font-bold transition-all @(statusFilter == "overdue" ? "bg-rose-600 text-white text-[#0d1f36] shadow" : "text-rose-400/80 hover:text-rose-700 bg-slate-50 border border-slate-200")">
                 متأخر
            </a>
            <a href="/ReturnManagement?statusFilter=onLeave" class="px-3 py-1.5 rounded-lg font-bold transition-all @(statusFilter == "onLeave" ? "bg-purple-600 text-[#0d1f36] shadow" : "text-purple-400/80 hover:text-purple-700 bg-slate-50 border border-slate-200")">
                 في الإجازة
            </a>
        </div>
    </div>

    <!-- جدول تمام واستلام الموظفين -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-2xl overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-center border-collapse text-xs">
                <thead>
                    <tr class="bg-[#112e51] text-white text-[11px] font-bold uppercase tracking-wider border-b border-[#0d1f36]">
                        <th class="py-3 px-4 text-right">اسم الموظف</th>
                        <th class="py-3 px-3">رقم الموظف</th>
                        <th class="py-3 px-3">الفئة / التصنيف</th>
                        <th class="py-3 px-3">تاريخ النزول الفعلي</th>
                        <th class="py-3 px-3 text-blue-700 font-bold">موعد العودة المخطط</th>
                        <th class="py-3 px-3">الموقف الرسمي</th>
                        <th class="py-3 px-4 text-center">تسجيل تمام الوصول والعودة</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 font-mono">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="py-12 text-center text-xs text-slate-500 font-sans">
                                <div class="flex flex-col items-center justify-center gap-2">
                                    <span class="text-3xl"></span>
                                    <span class="text-sm font-bold text-slate-700">لا يوجد موظفين في انتظار تسجيل العودة حالياً</span>
                                    <span class="text-[11px] text-slate-500">جميع الموظفين إما متواجدين في الخدمة أو تم تسجيل تمام وصولهم</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var s in Model)
                        {
                            string rowClass = "hover:bg-slate-50 transition-colors";
                            if (s.Status == MilitaryRoster.Models.Enums.SoldierDutyStatus.ReturnToday)
                            {
                                rowClass = "bg-blue-50/70 hover:bg-blue-900/50 border-r-4 border-r-blue-400";
                            }
                            else if (s.Status == MilitaryRoster.Models.Enums.SoldierDutyStatus.OverdueReturn)
                            {
                                rowClass = "bg-rose-50/80 hover:bg-rose-900/60 border-r-4 border-r-rose-500";
                            }

                            <tr class="@rowClass">
                                <!-- الاسم -->
                                <td class="py-3.5 px-4 text-right font-sans font-bold text-[#0d1f36] text-sm">
                                    <div class="flex items-center gap-2">
                                        <span>@s.FullName</span>
                                        @if (s.IsDemobSoon)
                                        {
                                            <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-rose-500/20 text-rose-700 border border-rose-500/30">
                                                رديف
                                            </span>
                                        }
                                    </div>
                                </td>

                                <!-- رقم الموظف -->
                                <td class="py-3 px-3 text-slate-700">
                                    @s.MilitaryNumber
                                </td>

                                <!-- الفئة -->
                                <td class="py-3 px-3 font-sans">
                                    <span class="px-2 py-0.5 rounded text-[11px] font-semibold @(s.SoldierTypeName.Contains("مدير") ? "bg-amber-500/10 text-amber-800 border border-amber-500/30" : "bg-blue-500/10 text-blue-700 border border-blue-500/30")">
                                        @s.SoldierTypeName
                                    </span>
                                </td>

                                <!-- تاريخ النزول الفعلي -->
                                <td class="py-3 px-3 text-slate-700">
                                    @(s.ActualLeaveDate?.ToArabic() ?? s.LeaveStartDate.ToArabic())
                                </td>

                                <!-- موعد العودة المخطط -->
                                <td class="py-3 px-3 font-bold @(s.Status == MilitaryRoster.Models.Enums.SoldierDutyStatus.ReturnToday ? "text-blue-700 font-black text-sm" : "text-[#0d1f36]")">
                                    @s.ExpectedReturnDate.ToArabic()
                                </td>

                                <!-- الموقف الرسمي -->
                                <td class="py-3 px-3 font-sans">
                                    @if (s.Status == MilitaryRoster.Models.Enums.SoldierDutyStatus.OverdueReturn)
                                    {
                                        <span class="px-2.5 py-1 rounded-lg text-xs font-black bg-rose-500/20 text-rose-700 border border-rose-500/30 animate-pulse inline-flex items-center gap-1">
                                            <span></span>
                                            <span>متأخر عن العودة</span>
                                        </span>
                                    }
                                    else if (s.Status == MilitaryRoster.Models.Enums.SoldierDutyStatus.ReturnToday)
                                    {
                                        <span class="px-2.5 py-1 rounded-lg text-xs font-black bg-blue-500/20 text-blue-700 border border-blue-500/30 inline-flex items-center gap-1">
                                            <span></span>
                                            <span>عودة اليوم (استلام)</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-purple-500/20 text-purple-700 border border-purple-500/30 inline-flex items-center gap-1">
                                            <span></span>
                                            <span>في الإجازة</span>
                                        </span>
                                    }
                                </td>

                                <!-- إجراء تسجيل العودة المباشر السلس -->
                                <td class="py-3 px-4 font-sans text-center">
                                    <div class="flex items-center justify-center gap-2">
                                        <!-- زر تسجيل فوري بنقرة واحدة -->
                                        <form method="post" action="/ReturnManagement/QuickConfirm/@s.SoldierId"
                                              onsubmit="return confirm('هل تؤكد تمام عودة الموظف @s.FullName اليوم (@DateTime.Today.ToArabic()) وبدء دورته الجديدة؟');"
                                              class="inline">
                                            <button type="submit"
                                                    class="px-3.5 py-1.5 rounded-lg text-xs font-bold bg-gradient-to-r from-emerald-600 to-teal-700 hover:from-emerald-500 hover:to-teal-600 text-[#0d1f36] shadow-md shadow-emerald-950/40 transition-all flex items-center gap-1.5 active:scale-95">
                                                <span>✓ تمام وصول الآن</span>
                                            </button>
                                        </form>

                                        <!-- زر تسجيل بتخصيص التاريخ/الوقت (مودال) -->
                                        <button type="button"
                                                onclick="openReturnModal(@s.SoldierId, '@s.FullName', '@s.ExpectedReturnDate.ToArabic()')"
                                                class="px-2.5 py-1.5 rounded-lg text-xs text-slate-700 hover:text-amber-600 bg-slate-100 hover:bg-slate-200 border border-slate-300 transition-colors"
                                                title="تحديد موعد أو ساعة محددة">
                                             تخصيص
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: تسجيل العودة بتخصيص التاريخ والساعة -->
<div id="custom-return-modal" class="fixed inset-0 z-50 overflow-y-auto hidden" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-slate-50/80 backdrop-blur-sm" onclick="closeReturnModal()"></div>
    <div class="flex min-h-screen items-center justify-center p-4">
        <div class="relative w-full max-w-md bg-white border border-slate-300 rounded-2xl p-6 shadow-2xl text-right">
            <div class="flex items-center justify-between pb-3 border-b border-slate-200">
                <div class="flex items-center gap-2">
                    <span class="text-xl"></span>
                    <h3 class="font-bold text-[#0d1f36] text-sm">تسجيل عودة الموظف واستلام الخدمة</h3>
                </div>
                <button type="button" onclick="closeReturnModal()" class="text-slate-500 hover:text-[#0d1f36] text-lg">✕</button>
            </div>

            <form method="post" action="/ReturnManagement/Register" class="mt-4 space-y-3.5 text-xs">
                <input type="hidden" id="modal-soldier-id" name="SoldierId" value="0" />
                
                <div>
                    <label class="block text-slate-500 mb-1">اسم الموظف</label>
                    <div id="modal-soldier-name" class="p-2.5 rounded-xl bg-slate-50 text-amber-600 font-bold border border-slate-200"></div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-slate-700 font-bold mb-1">تاريخ العودة الفعلي</label>
                        <input type="date" name="ActualReturnDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" required
                               class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-[#0d1f36] font-mono focus:border-amber-500 focus:outline-none" />
                    </div>
                    <div>
                        <label class="block text-slate-700 font-bold mb-1">وقت الوصول</label>
                        <input type="time" name="ActualReturnTime" value="@DateTime.Now.ToString("HH:mm")" required
                               class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-[#0d1f36] font-mono focus:border-amber-500 focus:outline-none" />
                    </div>
                </div>

                <div>
                    <label class="block text-slate-700 font-bold mb-1">القائم بتسجيل التمام</label>
                    <input type="text" name="ReturnedBy" value="نوبتجي العمليات" required
                           class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-[#0d1f36] focus:border-amber-500 focus:outline-none" />
                </div>

                <div>
                    <label class="block text-slate-700 font-bold mb-1">ملاحظات العودة</label>
                    <textarea name="Notes" rows="2" placeholder="أي ملاحظات حول انضباط عودة الموظف..."
                              class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-[#0d1f36] focus:border-amber-500 focus:outline-none"></textarea>
                </div>

                <div class="pt-3 border-t border-slate-200 flex justify-end gap-2">
                    <button type="button" onclick="closeReturnModal()" class="px-3.5 py-2 rounded-xl bg-slate-100 text-slate-700 hover:bg-slate-200 font-bold">
                        إلغاء
                    </button>
                    <button type="submit" class="px-4 py-2 rounded-xl font-bold bg-emerald-600 text-white hover:bg-emerald-500 text-[#0d1f36] shadow-lg">
                        تأكيد تسجيل العودة
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openReturnModal(soldierId, soldierName, expectedDate) {
        document.getElementById('modal-soldier-id').value = soldierId;
        document.getElementById('modal-soldier-name').innerText = soldierName;
        document.getElementById('custom-return-modal').classList.remove('hidden');
    }

    function closeReturnModal() {
        document.getElementById('custom-return-modal').classList.add('hidden');
    }
</script>
