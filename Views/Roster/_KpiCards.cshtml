@model MilitaryRoster.ViewModels.KpiSummaryViewModel

<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4 mb-6">
    <!-- إجمالي العساكر -->
    <div class="bg-white border border-slate-200 rounded-xl p-3.5 flex flex-col justify-between shadow-sm">
        <div class="flex items-center justify-between text-slate-600 mb-1">
            <span class="text-xs font-semibold">إجمالي القوة</span>
            <span class="p-1.5 rounded-lg bg-slate-100 text-slate-600">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
            </span>
        </div>
        <div class="text-2xl font-black text-[#0d1f36]">@Model.TotalForce</div>
        <div class="text-[11px] text-slate-500 mt-1">موظف مسجل بالمنظومة</div>
    </div>

    <!-- في الخدمة -->
    <div class="bg-white border border-slate-200 rounded-xl p-3.5 flex flex-col justify-between shadow-sm">
        <div class="flex items-center justify-between text-emerald-700 mb-1">
            <span class="text-xs font-semibold">في الخدمة</span>
            <span class="p-1.5 rounded-lg bg-emerald-50 text-emerald-600">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
            </span>
        </div>
        <div class="text-2xl font-black text-emerald-700">@Model.OnDutyCount</div>
        <div class="text-[11px] text-slate-500 mt-1">متواجد داخل مقر العمل</div>
    </div>

    <!-- في الإجازة -->
    <div class="bg-white border border-slate-200 rounded-xl p-3.5 flex flex-col justify-between shadow-sm">
        <div class="flex items-center justify-between text-purple-700 mb-1">
            <span class="text-xs font-semibold">في الإجازة</span>
            <span class="p-1.5 rounded-lg bg-purple-50 text-purple-600">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </span>
        </div>
        <div class="text-2xl font-black text-purple-700">@Model.OnLeaveCount</div>
        <div class="text-[11px] text-slate-500 mt-1">قيد قضاء فترة الراحة</div>
    </div>

    <!-- عودة اليوم -->
    <div class="bg-blue-50 border border-blue-200 rounded-xl p-3.5 flex flex-col justify-between shadow-sm relative overflow-hidden">
        <div class="absolute -top-6 -right-6 w-14 h-14 bg-blue-100 rounded-full blur-sm"></div>
        <div class="flex items-center justify-between text-blue-700 mb-1">
            <span class="text-xs font-semibold">عودة اليوم</span>
            <span class="p-1.5 rounded-lg bg-blue-100 text-blue-700">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
                </svg>
            </span>
        </div>
        <div class="text-2xl font-black text-blue-700">@Model.ReturnTodayCount</div>
        <div class="text-[11px] text-blue-600 mt-1 font-medium">استلام (التواجد يبدأ غداً)</div>
    </div>

    <!-- المسموح لهم بالنزول غداً (عمل البند) -->
    <div class="bg-amber-50 border border-amber-300 rounded-xl p-3.5 flex flex-col justify-between shadow-sm relative overflow-hidden">
        <div class="absolute -top-6 -right-6 w-14 h-14 bg-amber-100 rounded-full blur-sm"></div>
        <div class="flex items-center justify-between text-amber-800 mb-1">
            <span class="text-xs font-semibold">نزول غداً</span>
            <span class="p-1.5 rounded-lg bg-amber-100 text-amber-700 animate-pulse">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            </span>
        </div>
        <div class="text-2xl font-black text-amber-800">@Model.EligibleTomorrowCount</div>
        <div class="text-[11px] text-amber-700 mt-1 font-medium">تجهيز كشف البند</div>
    </div>

    <!-- نزول اليوم -->
    <div class="bg-emerald-50 border border-emerald-300 rounded-xl p-3.5 flex flex-col justify-between shadow-sm relative overflow-hidden">
        <div class="flex items-center justify-between text-emerald-800 mb-1">
            <span class="text-xs font-semibold">نزول اليوم</span>
            <span class="p-1.5 rounded-lg bg-emerald-100 text-emerald-700">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                </svg>
            </span>
        </div>
        <div class="text-2xl font-black text-emerald-800">@Model.LeaveTodayCount</div>
        <div class="text-[11px] text-emerald-700 mt-1 font-medium">جاهز للتنفيذ والتحرك</div>
    </div>
</div>

