@model MilitaryRoster.ViewModels.CreateSoldierDto

<div x-show="showAddModal"
     x-cloak
     class="fixed inset-0 z-50 overflow-y-auto"
     aria-labelledby="modal-title" role="dialog" aria-modal="true">

    <!-- Backdrop -->
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity"
         x-show="showAddModal"
         @@click="showAddModal = false"></div>

    <div class="flex min-h-screen items-center justify-center p-4 text-center">
        <div class="relative transform overflow-hidden rounded-2xl bg-white border border-slate-200 text-right shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-lg p-6">
            
            <div class="flex items-center justify-between pb-4 border-b border-slate-200">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-lg bg-amber-500/20 text-amber-700 flex items-center justify-center">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                        </svg>
                    </div>
                    <h3 class="text-base font-bold text-[#0d1f36]">إضافة وظيفي جديد وبدء الدورة</h3>
                </div>
                <button @@click="showAddModal = false" class="text-slate-500 hover:text-slate-900">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <form asp-controller="Personnel" asp-action="Create" method="post" class="mt-4 space-y-4 text-xs">
                <div>
                    <label class="block font-semibold text-slate-700 mb-1">الاسم بالكامل</label>
                    <input type="text" name="FullName" required placeholder="مثال: أحمد محمد علي إبراهيم"
                           class="w-full px-3 py-2 bg-white border border-slate-300 rounded-lg text-slate-900 shadow-sm placeholder-slate-500 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 focus:outline-none" />
                </div>

                <div>
                    <label class="block font-semibold text-slate-700 mb-1">رقم الموظف</label>
                    <input type="text" name="MilitaryNumber" required placeholder="مثال: 202310458999"
                           class="w-full px-3 py-2 bg-white border border-slate-300 rounded-lg text-slate-900 shadow-sm font-mono placeholder-slate-500 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 focus:outline-none" />
                </div>

                <div>
                    <label class="block font-semibold text-slate-700 mb-1">نوع الوظيفي وتكليفه</label>
                    <select name="SoldierTypeId" required
                            class="w-full px-3 py-2 bg-white border border-slate-300 rounded-lg text-slate-900 shadow-sm focus:border-amber-500 focus:ring-1 focus:ring-amber-500 focus:outline-none">
                        @if (ViewBag.SoldierTypes is List<MilitaryRoster.Models.Entities.SoldierType> types)
                        {
                            foreach (var t in types)
                            {
                                <option value="@t.Id">@t.Name (@t.DutyDays أيام تواجد / @t.LeaveDays أيام إجازة)</option>
                            }
                        }
                    </select>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">تاريخ آخر عودة (تاريخ الاستلام)</label>
                        <input type="date" name="InitialReturnDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" required
                               class="w-full px-3 py-2 bg-white border border-slate-300 rounded-lg text-slate-900 shadow-sm font-mono focus:border-amber-500 focus:ring-1 focus:ring-amber-500 focus:outline-none" />
                        <span class="text-[10px] text-slate-500">يبدأ عد التواجد من اليوم التالي</span>
                    </div>

                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">تاريخ إنهاء الخدمة (التسريح)</label>
                        <input type="date" name="ServiceEndDate" value="@DateTime.Today.AddMonths(12).ToString("yyyy-MM-dd")" required
                               class="w-full px-3 py-2 bg-white border border-slate-300 rounded-lg text-slate-900 shadow-sm font-mono focus:border-amber-500 focus:ring-1 focus:ring-amber-500 focus:outline-none" />
                    </div>
                </div>

                <div class="flex items-center justify-end gap-2 pt-4 border-t border-slate-200">
                    <button type="button" @@click="showAddModal = false" class="px-3.5 py-1.5 rounded-lg font-semibold bg-slate-100 text-slate-700 hover:bg-slate-700">
                        إلغاء
                    </button>
                    <button type="submit" class="px-4 py-1.5 rounded-lg font-bold bg-amber-600 text-white hover:bg-amber-500 text-white shadow">
                        حفظ الوظيفي وبدء الدورة
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
