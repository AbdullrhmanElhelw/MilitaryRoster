@model List<MilitaryRoster.Models.Entities.Soldier>

@{
    ViewData["Title"] = "سجل شؤون الموظفين والأفراد";
}

<div x-data="{ showAddModal: false }">
    <!-- Top Action Banner -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6 bg-white border border-slate-200 p-5 rounded-2xl shadow-lg">
        <div>
            <h2 class="text-lg font-bold text-[#0d1f36] flex items-center gap-2">
                <span>سجل كل الموظفين والأفراد</span>
                <span class="px-2.5 py-0.5 rounded-full text-xs bg-blue-50 text-blue-700 border border-blue-200">
                    عدد @Model.Count موظف
                </span>
            </h2>
            <p class="text-xs text-slate-500 mt-1">
                عرض البيانات التفصيلية الكاملة لجميع الموظفين المسجلين في المنظومة مرتبين حسب النزول الأخير (آخر نزل)، مع إمكانية استعراض الدورات التاريخية (Leave Cycles Audit).
            </p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <div>
                <button type="button"
                        @@click="showAddModal = true"
                        class="px-4 py-2 rounded-xl text-xs font-bold bg-[#205493] text-white hover:bg-[#1f4e79] shadow-lg transition-all flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                    <span>إضافة موظف جديد</span>
                </button>
            </div>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-6 p-4 rounded-xl bg-emerald-50 border border-emerald-300 text-emerald-800 text-xs font-bold flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-6 p-4 rounded-xl bg-rose-50 border border-rose-300 text-rose-800 text-xs font-bold flex items-center gap-2 shadow-sm animate-pulse">
            <svg class="w-5 h-5 text-rose-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Personnel Table -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-xl overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-right border-collapse text-xs">
                <thead>
                    <tr class="bg-[#112e51] text-white text-[11px] font-bold uppercase border-b border-[#0d1f36]">
                        <th class="py-3 px-4">#</th>
                        <th class="py-3 px-4">الاسم الكامل</th>
                        <th class="py-3 px-4">رقم الموظف</th>
                        <th class="py-3 px-4">نوع الموظف</th>
                        <th class="py-3 px-4">انتهاء الخدمة (التسريح)</th>
                        <th class="py-3 px-4">الحالة</th>
                        <th class="py-3 px-4">الدورة الحالية</th>
                        <th class="py-3 px-4 text-center">سجل التاريخي</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200">
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var s = Model[i];
                        bool isRedif = (s.ServiceEndDate.DayNumber - DateOnly.FromDateTime(DateTime.Today).DayNumber) <= 60;
                        var current = s.CurrentCycle;

                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="py-3 px-4 text-slate-500 font-mono">@(i + 1)</td>
                            <td class="py-3 px-4 font-bold text-slate-900">
                                <a href="/Soldiers/Details/@s.Id" class="text-blue-900 hover:text-[#205493] hover:underline flex items-center gap-1.5" title="عرض تفاصيل الموظف وإضافة ملاحظات">
                                    <span>@s.FullName</span>
                                    <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                    </svg>
                                </a>
                            </td>
                            <td class="py-3 px-4 font-mono text-slate-700">@s.MilitaryNumber</td>
                            <td class="py-3 px-4">
                                <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-slate-100 text-slate-800 border border-slate-300">
                                    @s.SoldierType.Name (@s.SoldierType.DutyDays/@s.SoldierType.LeaveDays)
                                </span>
                            </td>
                            <td class="py-3 px-4">
                                <div class="font-mono text-slate-800">@s.ServiceEndDate.ToArabic()</div>
                                @if (isRedif)
                                {
                                    <span class="inline-block px-1.5 py-0.5 rounded text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-200">
                                        قريب التسريح
                                    </span>
                                }
                            </td>
                            <td class="py-3 px-4">
                                <span class="px-2 py-0.5 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                    نشط
                                </span>
                            </td>
                            <td class="py-3 px-4 font-mono text-slate-700">
                                @(current != null ? $"دورة #{current.CycleNumber}" : "-")
                            </td>
                            <td class="py-3 px-4 text-center">
                                <div class="flex items-center justify-center gap-2">
                                    <a href="/Soldiers/Details/@s.Id#notes"
                                       class="px-2.5 py-1 rounded-md text-xs font-semibold bg-blue-50 text-blue-800 hover:bg-blue-100 border border-blue-200 transition-colors flex items-center gap-1"
                                       title="إضافة وعرض الملاحظات والتوجيهات">
                                        <svg class="w-3.5 h-3.5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
                                        </svg>
                                        <span>الملاحظات</span>
                                    </a>
                                    <button type="button"
                                            onclick="openHistoryModal(@s.Id)"
                                            class="px-2.5 py-1 rounded-md text-xs font-semibold bg-slate-100 text-slate-700 hover:bg-amber-50 hover:text-amber-800 border border-slate-300 transition-colors flex items-center gap-1 cursor-pointer"
                                            title="استعراض سجل الدورات التاريخي">
                                        <svg class="w-3.5 h-3.5 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                        <span>السجل (@s.LeaveCycles.Count)</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Add Soldier Modal -->
    @if (User.IsInRole("Admin"))
    {
        @await Html.PartialAsync("_AddSoldierModal", new MilitaryRoster.ViewModels.CreateSoldierDto())
    }

    <!-- History Log Modal Container -->
    <div id="historyModal"
         class="fixed inset-0 z-50 overflow-y-auto hidden"
         aria-labelledby="history-modal-title" role="dialog" aria-modal="true">
        <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm transition-opacity"
             onclick="closeHistoryModal()"></div>
        <div class="flex min-h-screen items-center justify-center p-4">
            <div class="relative transform overflow-hidden rounded-2xl bg-white border border-slate-200 shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-3xl"
                 id="history-modal-content">
                <div class="p-8 text-center text-slate-500 text-xs flex flex-col items-center justify-center gap-3">
                    <svg class="animate-spin h-7 w-7 text-amber-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                    </svg>
                    <span class="font-bold">جاري تحميل سجل دورات الموظف...</span>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    async function openHistoryModal(soldierId) {
        const modal = document.getElementById('historyModal');
        const content = document.getElementById('history-modal-content');
        
        // Show modal with animated spinner
        content.innerHTML = `
            <div class="p-8 text-center text-slate-500 text-xs flex flex-col items-center justify-center gap-3">
                <svg class="animate-spin h-7 w-7 text-amber-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                </svg>
                <span class="font-bold">جاري تحميل سجل دورات الموظف...</span>
            </div>
        `;
        modal.classList.remove('hidden');

        try {
            const resp = await fetch(`/Personnel/History/${soldierId}`, {
                headers: { 'HX-Request': 'true' }
            });
            if (!resp.ok) {
                throw new Error(`خطأ في الاتصال بالسيرفر (كود: ${resp.status})`);
            }
            const html = await resp.text();
            content.innerHTML = html;
        } catch (err) {
            content.innerHTML = `
                <div class="p-8 text-center space-y-3">
                    <div class="w-12 h-12 mx-auto rounded-full bg-rose-50 text-rose-600 flex items-center justify-center">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        </svg>
                    </div>
                    <div class="text-sm font-bold text-slate-800">تعذر تحميل السجل التاريخي</div>
                    <p class="text-xs text-rose-600 font-mono">${err.message}</p>
                    <div class="pt-2">
                        <button type="button" onclick="closeHistoryModal()" class="px-4 py-2 rounded-xl text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200 cursor-pointer">
                            إغلاق
                        </button>
                    </div>
                </div>
            `;
        }
    }

    function closeHistoryModal() {
        const modal = document.getElementById('historyModal');
        if (modal) {
            modal.classList.add('hidden');
        }
    }

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeHistoryModal();
        }
    });
</script>