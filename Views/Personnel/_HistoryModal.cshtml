@model List<MilitaryRoster.Models.Entities.LeaveCycle>

<div class="p-6">
    <div class="flex items-center justify-between pb-4 border-b border-slate-200">
        <div>
            <h3 class="text-base font-bold text-[#0d1f36]">سجل دورات الإجازات والتواجد (Leave Cycles Audit)</h3>
            <p class="text-xs text-slate-500 mt-0.5">
                الموظف: <span class="text-amber-700 font-bold">@ViewBag.SoldierName</span> (رقم الموظف: @ViewBag.MilitaryNumber) — 
                <span class="text-slate-700 font-semibold">@ViewBag.SoldierTypeName</span>
            </p>
        </div>
        <button type="button" onclick="closeHistoryModal()" class="text-slate-400 hover:text-slate-700 p-1.5 rounded-lg hover:bg-slate-100 transition-colors cursor-pointer">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
    </div>

    <div class="mt-4 max-h-96 overflow-y-auto">
        @if (!Model.Any())
        {
            <div class="py-8 text-center text-slate-500 text-xs">
                لا توجد دورات إجازة مسجلة لهذا الموظف حتى الآن.
            </div>
        }
        else
        {
            <table class="w-full text-right text-xs">
                <thead>
                    <tr class="bg-slate-50 text-slate-500 text-[11px] font-bold border-b border-slate-200">
                        <th class="py-2.5 px-3">الدورة</th>
                        <th class="py-2.5 px-3">تاريخ الاستلام</th>
                        <th class="py-2.5 px-3">النزول (مخطط / فعلي)</th>
                        <th class="py-2.5 px-3">العودة (مخطط / فعلي)</th>
                        <th class="py-2.5 px-3 text-center">خصم / منحة</th>
                        <th class="py-2.5 px-3">الحالة</th>
                        <th class="py-2.5 px-3">المسؤول</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 font-mono">
                    @foreach (var c in Model)
                    {
                        <tr class="hover:bg-slate-50">
                            <td class="py-2.5 px-3 font-bold text-amber-700">#@c.CycleNumber</td>
                            <td class="py-2.5 px-3 text-slate-700">@c.LastReturnDate.ToArabic()</td>
                            <td class="py-2.5 px-3">
                                <div class="text-slate-800">@c.LeaveStartDate.ToArabic()</div>
                                @if (c.ActualLeaveDate.HasValue)
                                {
                                    <div class="text-[10px] text-emerald-700 font-bold">فعلي: @c.ActualLeaveDate.Value.ToArabic()</div>
                                }
                            </td>
                            <td class="py-2.5 px-3">
                                <div class="text-slate-700">@c.ExpectedReturnDate.ToArabic()</div>
                                @if (c.ActualReturnDate.HasValue)
                                {
                                    <div class="text-[10px] text-blue-700 font-bold">فعلي: @c.ActualReturnDate.Value.ToArabic()</div>
                                }
                            </td>
                            <td class="py-2.5 px-3 text-center text-slate-700">
                                <span class="text-rose-700 font-bold">+@c.DeductionDays</span> / 
                                <span class="text-emerald-700 font-bold">-@c.BonusDays</span>
                            </td>
                            <td class="py-2.5 px-3 font-sans">
                                @if (c.IsCompleted)
                                {
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-600 border border-slate-300">
                                        دورة منتهية
                                    </span>
                                }
                                else
                                {
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                        الدورة الحالية
                                    </span>
                                }
                            </td>
                            <td class="py-2.5 px-3 font-sans text-slate-700">
                                @(string.IsNullOrEmpty(c.DispatchedBy) ? "-" : c.DispatchedBy)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="mt-4 pt-3 border-t border-slate-200 flex items-center justify-between">
        @if (ViewBag.SoldierId != null)
        {
            <a href="/Soldiers/Details/@ViewBag.SoldierId#notes"
               class="px-3.5 py-1.5 rounded-xl text-xs font-bold bg-[#205493] text-white hover:bg-[#1a4477] transition-colors flex items-center gap-1.5 shadow-sm">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
                <span>فتح ملف الموظف وإضافة ملاحظة ✍️</span>
            </a>
        }
        <button type="button" onclick="closeHistoryModal()" class="px-4 py-1.5 rounded-xl text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200 transition-colors cursor-pointer">
            إغلاق النافذة
        </button>
    </div>
</div>