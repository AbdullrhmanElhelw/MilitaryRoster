<!DOCTYPE html>
<html lang="ar" dir="rtl" class="h-full bg-[#f1f5f9] text-slate-800">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - منظومة إجازات وجداول الموظفين</title>

    <!-- Google Fonts: Cairo -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Tailwind CSS (Play CDN) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        cairo: ['Cairo', 'sans-serif'],
                    },
                    colors: {
                        navy: {
                            800: '#142c4b',
                            900: '#0d1f36',
                            950: '#081424',
                        },
                        gold: {
                            500: '#c69214',
                            600: '#a8790b',
                        }
                    }
                }
            }
        }
    </script>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- HTMX (Local) -->
    <script src="~/js/htmx.min.js"></script>

    <!-- Alpine.js (Local) -->
    <script defer src="~/js/alpine.min.js"></script>

    <style>
        [x-cloak] { display: none !important; }
        body { font-family: 'Cairo', sans-serif; }
        .font-mono, td.font-mono, span.font-mono, input.font-mono { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif !important; 
            letter-spacing: 0.5px;
            font-feature-settings: "tnum";
            font-variant-numeric: tabular-nums;
        }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #e2e8f0; }
        ::-webkit-scrollbar-thumb { background: #94a3b8; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #64748b; }
    </style>
    <script>
        // Arabic date display for all date inputs
        const AR_MONTHS = ['يناير','فبراير','مارس','أبريل','مايو','يونيو','يوليو','أغسطس','سبتمبر','أكتوبر','نوفمبر','ديسمبر'];
        function formatArabicDate(val) {
            if (!val) return '';
            const parts = val.split('-');
            if (parts.length !== 3) return '';
            const y = parts[0], m = parseInt(parts[1], 10), d = parseInt(parts[2], 10);
            if (!m || m < 1 || m > 12) return '';
            return `${d} ${AR_MONTHS[m - 1]} ${y}`;
        }

        let isSyncingDateLabels = false;
        function updateArabicDateInputs() {
            if (isSyncingDateLabels) return;
            isSyncingDateLabels = true;
            try {
                document.querySelectorAll('input[type="date"]').forEach(input => {
                    let label = input.nextElementSibling;
                    if (!label || !label.classList.contains('arabic-date-label')) {
                        label = document.createElement('div');
                        label.className = 'arabic-date-label text-[11px] text-amber-700 font-bold font-cairo mt-1 text-right';
                        input.parentNode.insertBefore(label, input.nextSibling);
                        input.addEventListener('change', () => syncDateLabel(input, label));
                        input.addEventListener('input', () => syncDateLabel(input, label));
                    }
                    syncDateLabel(input, label);
                });
            } finally {
                isSyncingDateLabels = false;
            }
        }

        function syncDateLabel(input, label) {
            const formatted = input.value ? '📅 ' + formatArabicDate(input.value) : '';
            if (label.textContent !== formatted) {
                label.textContent = formatted;
            }
        }

        document.addEventListener('DOMContentLoaded', updateArabicDateInputs);

        // Safe observer: Only trigger when actual date inputs are added to DOM, never on label text changes
        const dateInputObserver = new MutationObserver(mutations => {
            if (isSyncingDateLabels) return;
            let shouldUpdate = false;
            for (const m of mutations) {
                if (m.type === 'childList') {
                    for (const node of m.addedNodes) {
                        if (node.nodeType === 1) {
                            if (node.classList && node.classList.contains('arabic-date-label')) continue;
                            if (node.matches && node.matches('input[type="date"]')) {
                                shouldUpdate = true;
                                break;
                            }
                            if (node.querySelector && node.querySelector('input[type="date"]')) {
                                shouldUpdate = true;
                                break;
                            }
                        }
                    }
                }
                if (shouldUpdate) break;
            }
            if (shouldUpdate) {
                updateArabicDateInputs();
            }
        });

        document.addEventListener('DOMContentLoaded', () => {
            dateInputObserver.observe(document.body, { childList: true, subtree: true });
        });

        window.addEventListener('open-edit-soldier-modal', () => {
            setTimeout(updateArabicDateInputs, 50);
        });

        // Live System Clock & Date
        function initSystemLiveClock() {
            const days = ['الأحد', 'الإثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة', 'السبت'];
            const months = ['يناير', 'فبراير', 'مارس', 'أبريل', 'مايو', 'يونيو', 'يوليو', 'أغسطس', 'سبتمبر', 'أكتوبر', 'نوفمبر', 'ديسمبر'];

            function updateClock() {
                const now = new Date();
                const dayEl = document.getElementById('live-day-name');
                const dateEl = document.getElementById('live-full-date');
                const timeEl = document.getElementById('live-clock-time');
                const periodEl = document.getElementById('live-clock-period');

                if (!dayEl || !dateEl || !timeEl) return;

                const dayName = days[now.getDay()];
                const dayNum = String(now.getDate()).padStart(2, '0');
                const monthName = months[now.getMonth()];
                const year = now.getFullYear();

                dayEl.textContent = dayName;
                dateEl.textContent = `${dayNum} ${monthName} ${year}`;

                let hours = now.getHours();
                const minutes = String(now.getMinutes()).padStart(2, '0');
                const seconds = String(now.getSeconds()).padStart(2, '0');
                const period = hours >= 12 ? 'م' : 'ص';

                hours = hours % 12;
                hours = hours ? hours : 12;
                const formattedHours = String(hours).padStart(2, '0');

                timeEl.textContent = `${formattedHours}:${minutes}:${seconds}`;
                if (periodEl) periodEl.textContent = period;
            }

            updateClock();
            setInterval(updateClock, 1000);
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initSystemLiveClock);
        } else {
            initSystemLiveClock();
        }
    </script>
</head>
<body class="h-full flex bg-[#f8fafc] text-slate-800 antialiased font-cairo"
      x-data="{ sidebarOpen: false }">

    <!-- Sidebar Navigation (أنيق ووظيفي متناسق مع ألوان اللوجو) -->
    <aside class="fixed inset-y-0 right-0 z-50 w-64 bg-[#0d1f36] text-white border-l border-[#1a3a60] flex flex-col justify-between transition-transform duration-300 lg:static lg:translate-x-0 shadow-xl"
           :class="sidebarOpen ? 'translate-x-0' : 'translate-x-full lg:translate-x-0'">
        
        <div>
            <!-- Sidebar Header -->
            <div class="h-16 flex items-center justify-between px-4 border-b border-[#1a3a60] bg-[#081424]">
                <a href="/Roster" class="flex items-center gap-3">
                    <div class="w-10 h-10 flex items-center justify-center">
                        <img src="/images/logo.png" alt="شعار المنظومة" class="w-full h-full object-contain filter drop-shadow" />
                    </div>
                    <div>
                        <div class="text-xs font-black text-white">المنظومة</div>
                        <div class="text-[10px] text-amber-400 font-bold">منظومة إجازات وجداول الموظفين</div>
                    </div>
                </a>
                <button @@click="sidebarOpen = false" class="lg:hidden text-slate-500 hover:text-white">✕</button>
            </div>

            <!-- Navigation Links -->
            <nav class="p-3 space-y-1 text-xs">
                @{
                    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
                    var isAdmin = User.IsInRole("Admin");
                    var isSupervisor = User.IsInRole("Supervisor") || User.IsInRole("Manager") || User.IsInRole("Officer");
                    var isEmployee = User.IsInRole("Employee");
                }
                
                @if (isEmployee)
                {
                    <div class="px-3 pt-2 pb-1 text-[10px] font-black uppercase tracking-wider text-slate-400">بوابة الموظف</div>
                    <a href="/MyLeave" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-bold transition-all @(currentController == "MyLeave" ? "bg-gradient-to-r from-[#205493] to-[#112e51] text-white shadow-md border-r-4 border-r-amber-400" : "text-slate-300 hover:bg-white/10 hover:text-white")">
                        <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                        <span>متابعة إجازاتي وبياناتي</span>
                    </a>
                }
                else
                {
                    <!-- العمليات الرسمية اليومية للمشرفين والأدمن -->
                    <div class="px-3 pt-2 pb-1 text-[10px] font-black uppercase tracking-wider text-slate-400">العمليات اليومية</div>

                    <a href="/Roster" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-bold transition-all @(currentController == "Roster" ? "bg-gradient-to-r from-[#205493] to-[#112e51] text-white shadow-md border-r-4 border-r-amber-400" : "text-slate-300 hover:bg-white/10 hover:text-white")">
                        <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18m-9-4v8m-7 4h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        <span>كشف وجداول الموظفين</span>
                    </a>

                    <a href="/Personnel" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-bold transition-all @(currentController == "Personnel" ? "bg-gradient-to-r from-[#205493] to-[#112e51] text-white shadow-md border-r-4 border-r-amber-400" : "text-slate-300 hover:bg-white/10 hover:text-white")">
                        <svg class="w-4 h-4 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                        </svg>
                        <span>سجل قيد الموظفين</span>
                    </a>

                    <a href="/Dashboard" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-bold transition-all @(currentController == "Dashboard" ? "bg-gradient-to-r from-[#205493] to-[#112e51] text-white shadow-md border-r-4 border-r-amber-400" : "text-slate-300 hover:bg-white/10 hover:text-white")">
                        <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                        </svg>
                        <span>لوحة التمام والإحصائيات</span>
                    </a>

                    <a href="/LeaveClauses" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-bold transition-all @(currentController == "LeaveClauses" ? "bg-gradient-to-r from-[#205493] to-[#112e51] text-white shadow-md border-r-4 border-r-amber-400" : "text-slate-300 hover:bg-white/10 hover:text-white")">
                        <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                        </svg>
                        <span>اعتماد بنود النزول</span>
                    </a>

                    <a href="/ReturnManagement" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-bold transition-all @(currentController == "ReturnManagement" ? "bg-gradient-to-r from-[#205493] to-[#112e51] text-white shadow-md border-r-4 border-r-amber-400" : "text-slate-300 hover:bg-white/10 hover:text-white")">
                        <svg class="w-4 h-4 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
                        </svg>
                        <span>تسجيل عودة الموظفين</span>
                    </a>

                    <a href="/LeaveSchedule" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-bold transition-all @(currentController == "LeaveSchedule" ? "bg-gradient-to-r from-[#205493] to-[#112e51] text-white shadow-md border-r-4 border-r-amber-400" : "text-slate-300 hover:bg-white/10 hover:text-white")">
                        <svg class="w-4 h-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        <span>تقويم وجدول الإجازات</span>
                    </a>

                    <a href="/Reports" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-bold transition-all @(currentController == "Reports" ? "bg-gradient-to-r from-[#205493] to-[#112e51] text-white shadow-md border-r-4 border-r-amber-400" : "text-slate-300 hover:bg-white/10 hover:text-white")">
                        <svg class="w-4 h-4 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                        <span>كشوفات وتقارير الطباعة</span>
                    </a>

                    @if (isAdmin)
                    {
                        <!-- الإدارة والتكوين خاصة بالأدمن فقط -->
                        <div class="px-3 pt-4 pb-1 text-[10px] font-black uppercase tracking-wider text-slate-400 border-t border-[#1a3a60] mt-2">لوحة الإدارة والتحكم</div>

                        <a href="/Admin" class="flex items-center justify-between px-3 py-2.5 rounded-xl font-bold transition-all @(currentController == "Admin" ? "bg-gradient-to-r from-[#205493] to-[#112e51] text-white shadow-md border-r-4 border-r-amber-400" : "text-slate-300 hover:bg-white/10 hover:text-white")">
                            <div class="flex items-center gap-3">
                                <svg class="w-4 h-4 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
                                </svg>
                                <span>لوحة الإدارة المركزية</span>
                            </div>
                        </a>

                        <a href="/Settings" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-bold transition-all @(currentController == "Settings" ? "bg-gradient-to-r from-[#205493] to-[#112e51] text-white shadow-md border-r-4 border-r-amber-400" : "text-slate-300 hover:bg-white/10 hover:text-white")">
                            <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                            </svg>
                            <span>إعدادات المنظومة</span>
                        </a>
                    }
                }
            </nav>
        </div>

        <!-- Sidebar User Footer -->
        <div class="p-4 border-t border-[#1a3a60] bg-[#081424]">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-lg bg-blue-500/20 text-blue-300 font-bold flex items-center justify-center text-xs border border-blue-500/30">
                            @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                        </div>
                        <div class="text-xs">
                            <div class="font-bold text-white">@User.Identity.Name</div>
                            <div class="text-[10px] text-amber-400 font-mono">
                                @(User.IsInRole("Admin") ? "مدير النظام (Admin)" : User.IsInRole("Supervisor") ? "مشرف الوحدة (صف ضابط)" : User.IsInRole("Employee") ? "موظف" : "مستخدم نظام")
                            </div>
                        </div>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                        <button type="submit" class="p-1.5 rounded-lg text-rose-300 hover:bg-rose-500/20 transition-colors" title="تسجيل الخروج">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                            </svg>
                        </button>
                    </form>
                </div>
            }
            else
            {
                <a href="/Account/Login" class="block w-full py-2 text-center rounded-xl bg-amber-500 hover:bg-amber-600 text-white text-slate-950 font-bold text-xs transition-colors shadow">
                    تسجيل الدخول
