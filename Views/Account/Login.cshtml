@model MilitaryRoster.ViewModels.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "تسجيل الدخول — المنظومة";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl" class="h-full bg-[#f1f5f9] text-slate-800">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تسجيل الدخول — المنظومة</title>

    <!-- Google Fonts: Cairo -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Tailwind CSS (Play CDN) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        cairo: ['Cairo', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Cairo', sans-serif; }
    </style>
</head>
<body class="min-h-full flex items-center justify-center p-4 antialiased bg-[#f8fafc] relative overflow-hidden">
    
    <!-- خلفية زخرفية هادئة تعكس الهوية البصرية -->
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-amber-400/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-md w-full bg-white border border-slate-200/90 p-8 sm:p-10 rounded-3xl shadow-xl relative overflow-hidden z-10">
        
        <!-- شريط علوي بألوان المنظومة -->
        <div class="absolute top-0 right-0 left-0 h-2 bg-gradient-to-r from-amber-600 via-[#112e51] to-amber-500"></div>

        <div class="text-center">
            <!-- شعار المنظومة -->
            <div class="w-24 h-24 mx-auto mb-2 flex items-center justify-center p-1 bg-slate-50 border border-slate-200 rounded-2xl shadow-inner">
                <img src="/images/logo.png" alt="المنظومة" class="w-full h-full object-contain filter drop-shadow" />
            </div>
            
            <h1 class="text-xl font-black tracking-tight text-[#0d1f36] mt-2">المنظومة</h1>
            <div class="text-xs font-bold text-amber-600 mt-0.5 tracking-wide">منظومة إدارة الإجازات والجداول</div>
            <p class="mt-2 text-xs text-slate-500 font-bold">أدخل بياناتك للوصول إلى منظومة إدارة إجازات وجداول الموظفين</p>
        </div>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div class="mt-4 p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-xs font-bold">
                @Html.ValidationSummary(true)
            </div>
        }

        <form asp-action="Login" method="post" class="mt-6 space-y-4">
            <input type="hidden" asp-for="ReturnUrl" />

            <div>
                <label asp-for="Username" class="block text-xs font-bold text-slate-700 mb-1.5">اسم المستخدم (المشرف المعتمد)</label>
                <div class="relative">
                    <input asp-for="Username" required autocomplete="username"
                           placeholder="مثال: admin"
                           class="w-full pl-3 pr-10 py-2.5 bg-white border border-slate-300 rounded-xl text-xs text-slate-900 placeholder-slate-400 focus:border-[#205493] focus:ring-1 focus:ring-[#205493] focus:outline-none font-mono transition-all shadow-sm" />
                    <svg class="w-5 h-5 text-slate-500 absolute right-3 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                </div>
            </div>

            <div>
                <label asp-for="Password" class="block text-xs font-bold text-slate-700 mb-1.5">كلمة المرور السرية</label>
                <div class="relative">
                    <input asp-for="Password" required autocomplete="current-password"
                           placeholder="••••••••"
                           class="w-full pl-3 pr-10 py-2.5 bg-white border border-slate-300 rounded-xl text-xs text-slate-900 placeholder-slate-400 focus:border-[#205493] focus:ring-1 focus:ring-[#205493] focus:outline-none font-mono transition-all shadow-sm" />
                    <svg class="w-5 h-5 text-slate-500 absolute right-3 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                </div>
            </div>

            <div class="flex items-center justify-between text-xs pt-1">
                <label class="flex items-center gap-2 text-slate-600 cursor-pointer select-none font-bold">
                    <input asp-for="RememberMe" type="checkbox"
                           class="rounded bg-white border-slate-300 text-amber-600 focus:ring-amber-500 h-4 w-4" />
                    <span>تذكر بيانات الدخول</span>
                </label>
                <span class="text-slate-500 font-mono text-[11px] bg-slate-100 px-2 py-0.5 rounded border border-slate-200">admin / Admin@123</span>
            </div>

            <button type="submit"
                    class="w-full py-3 px-4 rounded-xl text-xs font-black text-white bg-gradient-to-r from-[#205493] to-[#112e51] hover:from-[#1b467a] hover:to-[#0c2440] shadow-md transition-all flex items-center justify-center gap-2 active:scale-95 cursor-pointer">
                <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
                </svg>
                <span>دخول للمنظومة </span>
            </button>
        </form>
    </div>
</body>
</html>