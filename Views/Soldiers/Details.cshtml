@model MilitaryRoster.ViewModels.SoldierDetailsViewModel

@{
    ViewData["Title"] = $"تفاصيل الموظف: {Model.Soldier.FullName}";
    var s = Model.Soldier;
    var status = Model.CurrentStatus;
}

<div class="space-y-6">
    <!-- Top Navigation Header -->
    <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
            <a href="/Soldiers" class="p-2 rounded-xl bg-white border border-slate-200 text-slate-600 hover:text-slate-900 transition-colors">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
            </a>
            <div>
                <div class="flex items-center gap-2">
                    <h2 class="text-xl font-black text-[#0d1f36]">@s.FullName</h2>
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-blue-50 text-blue-800 border border-blue-200">
                        رقم الموظف: @s.MilitaryNumber
                    </span>
                </div>
                <p class="text-xs text-slate-500 mt-0.5">نوع الموظف: @s.SoldierType.Name (@s.SoldierType.DutyDays تواجد / @s.SoldierType.LeaveDays إجازة)</p>
            </div>
        </div>

        <a href="/Soldiers" class="px-3.5 py-2 rounded-xl text-xs font-bold bg-slate-100 text-slate-800 hover:bg-slate-200 border border-slate-300 shadow-sm transition-colors">
            العودة لجدول الموظفين
        </a>
    </div>

    <!-- Current Cycle & Progress Card -->
    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-xl space-y-5">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-200 gap-3">
            <div>
                <h3 class="text-sm font-bold text-[#0d1f36] flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
                    <span>الدورة الحالية: #{status.CycleNumber}</span>
                </h3>
                <p class="text-xs text-slate-500 mt-0.5">الموقف الرسمي الفعلي والعداد اللحظي للتواجد بالخدمة</p>
            </div>

            <div>
                <span class="px-3 py-1 rounded-xl text-xs font-bold bg-amber-100 text-amber-800 font-bold border border-slate-300">
                    الحالة: @status.StatusName
                </span>
            </div>
        </div>

        <!-- Duty Progress Bar -->
        <div>
            <div class="flex items-center justify-between text-xs mb-2">
                <span class="font-bold text-slate-700">مؤشر أيام التواجد بالخدمة (Duty Days Progress)</span>
                <span class="font-mono text-emerald-700 font-bold">
                    @(status.CurrentDutyDayNumber.HasValue ? $"Duty Day {status.CurrentDutyDayNumber} / {status.DutyDays}" : "خارج فترة التواجد")
                </span>
            </div>
            @{
                int progressPct = status.CurrentDutyDayNumber.HasValue ? Math.Min(100, (status.CurrentDutyDayNumber.Value * 100) / status.DutyDays) : 0;
            }
            <div class="w-full bg-slate-50 rounded-full h-3.5 overflow-hidden p-0.5 border border-slate-200">
                <div class="bg-gradient-to-l from-emerald-500 to-blue-600 h-2.5 rounded-full transition-all duration-500" style="width: @progressPct%"></div>
            </div>
        </div>

        <!-- Dates Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-2 font-mono">
            <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200/80">
                <div class="text-[10px] text-slate-500 font-sans mb-1">تاريخ آخر عودة (استلام)</div>
                <div class="text-sm font-bold text-slate-800">@status.LastReturnDate.ToArabic()</div>
            </div>
            <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200/80">
                <div class="text-[10px] text-slate-500 font-sans mb-1">بداية التواجد الفعلي (Duty #1)</div>
                <div class="text-sm font-bold text-emerald-700">@status.LastReturnDate.AddDays(1).ToArabic()</div>
            </div>
            <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200/80">
                <div class="text-[10px] text-slate-500 font-sans mb-1">موعد النزول القادم</div>
                <div class="text-sm font-bold text-amber-700">@status.LeaveStartDate.ToArabic()</div>
            </div>
            <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200/80">
                <div class="text-[10px] text-slate-500 font-sans mb-1">موعد العودة المخطط</div>
                <div class="text-sm font-bold text-blue-700">@status.ExpectedReturnDate.ToArabic()</div>
            </div>
        </div>
    </div>

    <!-- Full Cycle History (Immutable Audit Log) -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-xl p-6">
        <h3 class="text-sm font-bold text-[#0d1f36] mb-4 pb-2 border-b border-slate-200 flex items-center justify-between">
            <span>سجل الإجازات والدورات التاريخية (Leave Cycles Audit History)</span>
            <span class="text-xs text-slate-500 font-mono">إجمالي الدورات: @Model.CycleHistory.Count دورة</span>
        </h3>

        <div class="overflow-x-auto">
            <table class="w-full text-right text-xs">
                <thead>
                    <tr class="bg-slate-50 text-slate-500 text-[11px] font-bold border-b border-slate-200">
                        <th class="py-2.5 px-3">رقم الدورة</th>
                        <th class="py-2.5 px-3">تاريخ النزول المخطط</th>
                        <th class="py-2.5 px-3">النزول الفعلي</th>
                        <th class="py-2.5 px-3">العودة المخططة</th>
                        <th class="py-2.5 px-3">العودة الفعلية</th>
                        <th class="py-2.5 px-3">أيام الإجازة</th>
                        <th class="py-2.5 px-3">منفذ البند</th>
                        <th class="py-2.5 px-3">مسجل العودة</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 font-mono">
                    @foreach (var c in Model.CycleHistory)
                    {
                        <tr class="hover:bg-slate-50">
                            <td class="py-2.5 px-3 text-amber-700 font-bold">دورة #@c.CycleNumber</td>
                            <td class="py-2.5 px-3 text-slate-700">@c.LeaveStartDate.ToArabic()</td>
                            <td class="py-2.5 px-3 text-blue-700">@(c.ActualLeaveDate?.ToArabic() ?? "قيد الانتظار")</td>
                            <td class="py-2.5 px-3 text-slate-700">@c.ExpectedReturnDate.ToArabic()</td>
                            <td class="py-2.5 px-3 text-emerald-700 font-bold">@(c.ActualReturnDate?.ToArabic() ?? "-")</td>
                            <td class="py-2.5 px-3">@c.LeaveDaysSnapshot يوم</td>
                            <td class="py-2.5 px-3 font-sans text-slate-500">@(c.ClauseExecutedBy ?? "-")</td>
                            <td class="py-2.5 px-3 font-sans text-slate-500">@(c.ReturnedBy ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Performance Notes & Admin Approval Section -->
    @{
        var notes = ViewBag.Notes as List<MilitaryRoster.Models.Entities.EmployeeNote> ?? new();
        var isStaffUser = User.IsInRole("Admin") || User.IsInRole("Supervisor") || User.IsInRole("Manager") || User.IsInRole("Officer");
        var isAdminUser = User.IsInRole("Admin");
    }
    <div id="notes" class="bg-white border border-slate-200 rounded-2xl shadow-xl p-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-200 mb-6 gap-3">
            <div>
                <h3 class="text-base font-bold text-[#0d1f36] flex items-center gap-2">
                    <svg class="w-5 h-5 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
                    </svg>
                    <span>ملاحظات وتوجيهات الأداء والسلوك</span>
                </h3>
                <p class="text-xs text-slate-500 mt-0.5">يقوم المشرفون (صف الضباط) بكتابة الملاحظات، ولا تصبح نافذة أو مرئية للموظف إلا بعد اعتماد مدير النظام (الأدمن).</p>
            </div>
            <span class="px-3 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-700 font-mono">
                @notes.Count ملاحظة مسجلة
            </span>
        </div>

        <!-- Notes List -->
        @if (notes.Any())
        {
            <div class="space-y-3 mb-6">
                @foreach (var note in notes)
                {
                    <div class="p-4 rounded-xl border transition-all @(note.Status == MilitaryRoster.Models.Entities.NoteStatus.Pending ? "bg-amber-50/50 border-amber-200" : note.Status == MilitaryRoster.Models.Entities.NoteStatus.Approved ? "bg-slate-50 border-slate-200" : "bg-rose-50/40 border-rose-200 opacity-70")">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
                            <div class="flex items-center gap-2">
                                <span class="px-2 py-0.5 rounded text-[10px] font-bold @(note.AuthorRole == "Admin" ? "bg-purple-100 text-purple-800 border border-purple-200" : "bg-blue-100 text-blue-800 border border-blue-200")">
                                    @(note.AuthorRole == "Admin" ? "مدير النظام" : "مشرف (صف ضابط)")
                                </span>
                                <span class="text-xs font-bold text-slate-800">@note.AuthorFullName</span>
                                <span class="text-[11px] text-slate-400 font-mono">(@note.CreatedAt.ToArabic())</span>
                            </div>

                            <div class="flex items-center gap-2">
                                @if (note.Status == MilitaryRoster.Models.Entities.NoteStatus.Pending)
                                {
                                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 border border-amber-300 flex items-center gap-1">
                                        <span>⏳</span>
                                        <span>قيد المراجعة (بانتظار موافقة الأدمن)</span>
                                    </span>

                                    @if (isAdminUser)
                                    {
                                        <form asp-controller="Admin" asp-action="ApproveNote" asp-route-id="@note.Id" method="post" class="inline">
                                            <input type="hidden" name="returnTab" value="notes" />
                                            <button type="submit" class="px-2.5 py-1 rounded-lg text-[10px] font-bold bg-emerald-600 hover:bg-emerald-700 text-white transition-colors">
                                                ✓ اعتماد الملاحظة
                                            </button>
                                        </form>

                                        <form asp-controller="Admin" asp-action="RejectNote" asp-route-id="@note.Id" method="post" class="inline"
                                              onsubmit="return confirm('هل أنت متأكد من رفض هذه الملاحظة؟');">
                                            <input type="hidden" name="returnTab" value="notes" />
                                            <button type="submit" class="px-2.5 py-1 rounded-lg text-[10px] font-bold bg-rose-50 text-rose-700 hover:bg-rose-100 border border-rose-300 transition-colors">
                                                ✕ رفض
                                            </button>
                                        </form>
                                    }
                                }
                                else if (note.Status == MilitaryRoster.Models.Entities.NoteStatus.Approved)
                                {
                                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-300 flex items-center gap-1">
                                        <span>✓</span>
                                        <span>معتمدة رسمياً @(note.ApprovedBy != null ? $"بواسطة {note.ApprovedBy}" : "")</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800 border border-rose-300">
                                        ✕ تم رفضها
                                    </span>
                                }
                            </div>
                        </div>

                        <p class="text-xs text-slate-800 font-medium leading-relaxed mt-1">@note.NoteText</p>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-6 text-xs text-slate-400 mb-6 bg-slate-50 rounded-xl border border-slate-100">
                لا توجد أي ملاحظات مسجلة بحق هذا الموظف حتى الآن.
            </div>
        }

        <!-- Add New Note Form (for Staff: Supervisors & Admin) -->
        @if (isStaffUser)
        {
            <div class="pt-6 border-t border-slate-200">
                <h4 class="text-xs font-bold text-[#0d1f36] mb-2 flex items-center gap-2">
                    <svg class="w-4 h-4 text-[#205493]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                    <span>إضافة ملاحظة جديدة على الموظف</span>
                </h4>

                <div class="mb-3 p-3 rounded-xl @(isAdminUser ? "bg-purple-50 border border-purple-200 text-purple-800" : "bg-amber-50 border border-amber-200 text-amber-800") text-[11px] font-bold flex items-center gap-2">
                    <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>
                        @(isAdminUser 
                            ? "بصفتك مدير النظام (Admin): سيتم اعتماد الملاحظة ونشرها فورياً في ملف الموظف وبوابته." 
                            : "بصفتك مشرفاً (صف ضابط): سيتم تسجيل الملاحظة كمسودة معلقة ولن تظهر للموظف إلا بعد اعتمادها من مدير النظام (الأدمن).")
                    </span>
                </div>

                <form asp-controller="Soldiers" asp-action="AddNote" asp-route-soldierId="@Model.Soldier.Id" method="post" class="space-y-3">
                    <textarea name="noteText" required rows="3" placeholder="اكتب الملاحظة، السلوك، التوجيه، أو الموقف الانضباطي هنا..."
                              class="w-full p-3 bg-slate-50 border border-slate-300 rounded-xl text-xs text-slate-900 focus:bg-white focus:border-[#205493] focus:outline-none transition-colors"></textarea>
                    
                    <div class="flex justify-end">
                        <button type="submit" class="px-5 py-2 rounded-xl text-xs font-bold bg-[#205493] text-white hover:bg-[#1f4e79] shadow transition-all flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                            </svg>
                            <span>تسجيل الملاحظة</span>
                        </button>
                    </div>
                </form>
            </div>
        }
    </div>
</div>
