@model MilitaryRoster.ViewModels.PagedList<MilitaryRoster.ViewModels.RosterItemViewModel>

@{
    ViewData["Title"] = "شؤون الموظفين (Soldiers)";
    var types = ViewBag.Types as List<MilitaryRoster.Models.Entities.SoldierType> ?? new();
    var selectedType = ViewBag.SelectedType as int?;
    var selectedStatus = ViewBag.SelectedStatus as MilitaryRoster.Models.Enums.SoldierDutyStatus?;
    var search = ViewBag.Search as string;
}

<div class="space-y-6" x-data="{ addModalOpen: false, editModalOpen: false, currentEdit: { id: 0, name: '', number: '', typeId: 1, endDate: '', notes: '' } }">
    
    <!-- Top Action Banner -->
    <div class="bg-white border border-slate-200 p-5 rounded-2xl shadow-lg flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-blue-700 text-xs font-bold mb-1">
                <span> سجل قيد وبيانات الموظفين الرسمي</span>
                <span class="px-2 py-0.5 rounded-full bg-blue-500/20 text-blue-700 text-[10px] font-mono">@Model.TotalCount موظف مسجل</span>
            </div>
            <h2 class="text-xl font-black text-[#0d1f36]">إدارة ملفات الموظفين ودورات التواجد</h2>
            <p class="text-xs text-slate-500 mt-1">استعراض الموقف اللحظي، الفلترة حسب الحالة، ومتابعة السجلات التاريخية للموظفين.</p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <button type="button" @@click="addModalOpen = true"
                    class="px-4 py-2.5 rounded-xl text-xs font-bold bg-[#205493] text-white hover:bg-[#1f4e79] shadow-lg transition-all flex items-center gap-2 self-start md:self-auto">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                <span>إضافة موظف جديد</span>
            </button>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-300 text-emerald-800 text-xs font-bold flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-300 text-rose-800 text-xs font-bold flex items-center gap-2 shadow-sm animate-pulse">
            <svg class="w-5 h-5 text-rose-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Search & Filters Toolbar -->
    <div class="bg-white border border-slate-200 p-4 rounded-xl flex flex-wrap items-center justify-between gap-3">
        <form method="get" action="/Soldiers" class="flex flex-wrap items-center gap-2.5 w-full md:w-auto">
            <!-- Search -->
            <input type="text" name="search" value="@search" placeholder="بحث بالاسم أو رقم الموظف..."
                   class="px-3 py-1.5 bg-white border border-slate-300 rounded-lg text-xs text-slate-900 placeholder-slate-400 focus:border-blue-600 focus:outline-none min-w-[200px] shadow-sm" />

            <!-- Type Filter -->
            <select name="soldierTypeId" class="px-2.5 py-1.5 bg-slate-50 border border-slate-300 rounded-lg text-xs text-slate-800 focus:border-blue-500 focus:outline-none">
                <option value="">جميع أنواع الموظفين</option>
                @foreach (var t in types)
                {
                    <option value="@t.Id" selected="@(selectedType == t.Id)">@t.Name (@t.DutyDays/@t.LeaveDays)</option>
                }
            </select>

            <!-- Status Filter -->
            <select name="status" class="px-2.5 py-1.5 bg-slate-50 border border-slate-300 rounded-lg text-xs text-slate-800 focus:border-blue-500 focus:outline-none">
                <option value="">جميع الحالات</option>
                <option value="0" selected="@(selectedStatus == MilitaryRoster.Models.Enums.SoldierDutyStatus.OnDuty)">متواجد بالخدمة</option>
                <option value="1" selected="@(selectedStatus == MilitaryRoster.Models.Enums.SoldierDutyStatus.EligibleForLeave)">مستحق النزول غداً</option>
                <option value="2" selected="@(selectedStatus == MilitaryRoster.Models.Enums.SoldierDutyStatus.LeaveToday)">نزول اليوم</option>
                <option value="3" selected="@(selectedStatus == MilitaryRoster.Models.Enums.SoldierDutyStatus.OnLeave)">في إجازة</option>
                <option value="4" selected="@(selectedStatus == MilitaryRoster.Models.Enums.SoldierDutyStatus.ReturnToday)">عودة اليوم</option>
                <option value="5" selected="@(selectedStatus == MilitaryRoster.Models.Enums.SoldierDutyStatus.OverdueReturn)">متأخر عن العودة</option>
            </select>

            <button type="submit" class="px-3.5 py-1.5 rounded-lg text-xs font-bold bg-slate-100 text-slate-800 hover:bg-slate-700 transition-colors">
                تصفية
            </button>
            <a href="/Soldiers" class="px-2.5 py-1.5 text-xs text-slate-500 hover:text-white">إلغاء الفلتر</a>
        </form>
    </div>

    <!-- Soldiers Table -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-xl overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-right text-xs">
                <thead>
                    <tr class="bg-[#112e51] text-white text-[11px] font-bold border-b border-[#0d1f36]">
                        <th class="py-3 px-3">رقم الموظف</th>
                        <th class="py-3 px-3">اسم الموظف</th>
                        <th class="py-3 px-3">النوع</th>
                        <th class="py-3 px-3">الحالة الحالية</th>
                        <th class="py-3 px-3">تاريخ آخر عودة</th>
                        <th class="py-3 px-3">موعد النزول القادم</th>
                        <th class="py-3 px-3">موعد العودة</th>
                        <th class="py-3 px-3">عداد الخدمة</th>
                        <th class="py-3 px-3 text-center">الإجراءات</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200/80 font-mono">
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="9" class="py-8 text-center text-slate-500 text-xs font-sans">
                                لا يوجد موظفين مطابقون لخيارات البحث المحددة
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var s in Model.Items)
                        {
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="py-3 px-3 text-slate-700">@s.MilitaryNumber</td>
                                <td class="py-3 px-3 font-sans font-bold text-slate-900 text-sm">
                                    <a href="/Soldiers/Details/@s.SoldierId" class="hover:text-blue-700">@s.FullName</a>
                                </td>
                                <td class="py-3 px-3 font-sans">
                                    <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-100 text-slate-700 border border-slate-300">
                                        @s.SoldierTypeName
                                    </span>
                                </td>
                                <td class="py-3 px-3 font-sans">
                                    @if (s.Status == MilitaryRoster.Models.Enums.SoldierDutyStatus.OverdueReturn)
                                    {
                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-rose-500/20 text-rose-700 border border-rose-500/40 animate-pulse">
                                            متأخر عن العودة
                                        </span>
                                    }
                                    else if (s.Status == MilitaryRoster.Models.Enums.SoldierDutyStatus.EligibleForLeave)
                                    {
                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/20 text-amber-800 border border-amber-500/40 animate-pulse">
                                            نزول غداً (عمل البند)
                                        </span>
                                    }
                                    else if (s.Status == MilitaryRoster.Models.Enums.SoldierDutyStatus.LeaveToday)
                                    {
                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-blue-500/20 text-blue-700 border border-blue-500/40">
                                            نزول اليوم
                                        </span>
                                    }
                                    else if (s.Status == MilitaryRoster.Models.Enums.SoldierDutyStatus.ReturnToday)
                                    {
                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/20 text-emerald-700 border border-emerald-500/40">
                                            عودة اليوم
                                        </span>
                                    }
                                    else if (s.Status == MilitaryRoster.Models.Enums.SoldierDutyStatus.OnLeave)
                                    {
                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-purple-500/20 text-purple-700 border border-purple-500/40">
                                            في إجازة
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-700 border border-slate-300">
                                            متواجد بالخدمة
                                        </span>
                                    }
                                </td>
                                <td class="py-3 px-3 text-slate-700">@s.LastReturnDate.ToArabic()</td>
                                <td class="py-3 px-3 font-bold text-slate-900">@s.LeaveStartDate.ToArabic()</td>
                                <td class="py-3 px-3 text-slate-500">@s.ExpectedReturnDate.ToArabic()</td>
                                <td class="py-3 px-3 font-sans">
                                    @if (s.CurrentDutyDayNumber.HasValue)
                                    {
                                        <span class="text-emerald-700 font-bold font-mono">اليوم @s.CurrentDutyDayNumber / @s.DutyDays</span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-500">-</span>
                                    }
                                </td>
                                <td class="py-3 px-3 text-center font-sans">
                                    <div class="flex items-center justify-center gap-1.5">
                                        <a href="/Soldiers/Details/@s.SoldierId" class="px-2.5 py-1 rounded bg-slate-100 text-slate-700 hover:bg-slate-200" title="عرض التفاصيل والسجل">
                                            عرض
                                        </a>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <button type="button" @@click="currentEdit = { id: @s.SoldierId, name: '@s.FullName', number: '@s.MilitaryNumber', typeId: @s.SoldierTypeId, endDate: '@s.ServiceEndDate.ToString("yyyy-MM-dd")', notes: '' }; editModalOpen = true;"
                                                    class="px-2 py-1 rounded bg-amber-50 text-amber-700 border border-amber-200 hover:bg-amber-100">
                                                تعديل
                                            </button>
                                            <form asp-action="Delete" asp-route-id="@s.SoldierId" method="post" onsubmit="return confirm('تأكيد حذف الموظف نهائياً؟');" class="inline">
                                                <button type="submit" class="px-2 py-1 rounded bg-rose-50 text-rose-700 border border-rose-200 hover:bg-rose-100">
                                                    حذف
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Controls -->
        <div class="p-3 bg-slate-50 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
            <div class="text-slate-500 font-mono">
                عرض <span class="font-bold text-white">@Model.StartItemIndex - @Model.EndItemIndex</span> من إجمالي <span class="font-bold text-white">@Model.TotalCount</span> موظف
            </div>

            <div class="flex items-center gap-1">
                <a href="/Soldiers?page=@(Model.PageNumber - 1)&pageSize=@Model.PageSize&soldierTypeId=@selectedType&status=@selectedStatus&search=@search"
                   class="px-2.5 py-1 rounded bg-slate-100 text-slate-700 hover:bg-slate-700 font-bold @(Model.HasPreviousPage ? "" : "pointer-events-none opacity-40")">
                    السابق
                </a>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <a href="/Soldiers?page=@p&pageSize=@Model.PageSize&soldierTypeId=@selectedType&status=@selectedStatus&search=@search"
                       class="px-2.5 py-1 rounded font-mono font-bold @(Model.PageNumber == p ? "bg-[#2e75b6] text-white" : "bg-slate-100/80 text-slate-700 hover:bg-slate-700")">
                        @p
                    </a>
                }
                <a href="/Soldiers?page=@(Model.PageNumber + 1)&pageSize=@Model.PageSize&soldierTypeId=@selectedType&status=@selectedStatus&search=@search"
                   class="px-2.5 py-1 rounded bg-slate-100 text-slate-700 hover:bg-slate-700 font-bold @(Model.HasNextPage ? "" : "pointer-events-none opacity-40")">
                    التالي
                </a>
            </div>
        </div>
    </div>

    @if (User.IsInRole("Admin"))
    {
        <!-- Modal: Add Soldier -->
        <div x-show="addModalOpen" x-cloak class="fixed inset-0 z-50 overflow-y-auto" role="dialog" aria-modal="true">
            <div class="fixed inset-0 bg-slate-50/80 backdrop-blur-sm" @@click="addModalOpen = false"></div>
            <div class="flex min-h-screen items-center justify-center p-4">
                <div class="relative w-full max-w-lg bg-white border border-slate-200 rounded-2xl p-6 shadow-2xl">
                    <div class="flex items-center justify-between pb-3 border-b border-slate-200">
                        <h3 class="font-bold text-[#0d1f36] text-sm">إضافة موظف جديد للنظام</h3>
                        <button @@click="addModalOpen = false" class="text-slate-500 hover:text-white">✕</button>
                    </div>
                    <form asp-action="Create" method="post" class="mt-4 space-y-3 text-xs">
                        <div>
                            <label class="block text-slate-700 mb-1 font-semibold">اسم الموظف بالكامل</label>
                            <input type="text" name="FullName" required placeholder="مثال: حسام محمد السيد"
                                   class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 focus:border-blue-500 focus:outline-none" />
                        </div>
                        <div>
                            <label class="block text-slate-700 mb-1 font-semibold">رقم الموظف</label>
                            <input type="text" name="MilitaryNumber" required placeholder="مثال: 2023999"
                                   class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 font-mono focus:border-blue-500 focus:outline-none" />
                        </div>
                        <div>
                            <label class="block text-slate-700 mb-1 font-semibold">نوع الموظف (يحدد مدة التواجد والإجازة آلياً)</label>
                            <select name="SoldierTypeId" required
                                    class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 focus:border-blue-500 focus:outline-none">
                                @foreach (var t in types)
                                {
                                    <option value="@t.Id">@t.Name (@t.DutyDays تواجد / @t.LeaveDays إجازة)</option>
                                }
                            </select>
                        </div>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-slate-700 mb-1 font-semibold">تاريخ الاستلام / العودة الأولي</label>
                                <input type="date" name="InitialReturnDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" required
                                       class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 font-mono focus:border-blue-500 focus:outline-none" />
                            </div>
                            <div>
                                <label class="block text-slate-700 mb-1 font-semibold">تاريخ انتهاء الخدمة (التسريح)</label>
                                <input type="date" name="ServiceEndDate" value="@DateTime.Today.AddMonths(12).ToString("yyyy-MM-dd")" required
                                       class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 font-mono focus:border-blue-500 focus:outline-none" />
                            </div>
                        </div>
                        <div>
                            <label class="block text-slate-700 mb-1 font-semibold">ملاحظات</label>
                            <textarea name="Notes" rows="2" placeholder="أي ملاحظات أو قيود انضباطية..."
                                      class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 focus:border-blue-500 focus:outline-none"></textarea>
                        </div>
                        <div class="pt-3 border-t border-slate-200 flex justify-end gap-2">
                            <button type="button" @@click="addModalOpen = false" class="px-3.5 py-1.5 rounded-lg bg-slate-100 text-slate-700">إلغاء</button>
                            <button type="submit" class="px-4 py-1.5 rounded-lg font-bold bg-[#205493] text-white hover:bg-[#1f4e79] text-white">حفظ الموظف</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Modal: Edit Soldier -->
        <div x-show="editModalOpen" x-cloak class="fixed inset-0 z-50 overflow-y-auto" role="dialog" aria-modal="true">
            <div class="fixed inset-0 bg-slate-50/80 backdrop-blur-sm" @@click="editModalOpen = false"></div>
            <div class="flex min-h-screen items-center justify-center p-4">
                <div class="relative w-full max-w-lg bg-white border border-slate-200 rounded-2xl p-6 shadow-2xl">
                    <div class="flex items-center justify-between pb-3 border-b border-slate-200">
                        <h3 class="font-bold text-[#0d1f36] text-sm">تعديل بيانات الموظف</h3>
                        <button @@click="editModalOpen = false" class="text-slate-500 hover:text-white">✕</button>
                    </div>
                    <form :action="'/Soldiers/Edit/' + currentEdit.id" method="post" class="mt-4 space-y-3 text-xs">
                        <div>
                            <label class="block text-slate-700 mb-1 font-semibold">اسم الموظف</label>
                            <input type="text" name="fullName" x-model="currentEdit.name" required
                                   class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 focus:border-blue-500 focus:outline-none" />
                        </div>
                        <div>
                            <label class="block text-slate-700 mb-1 font-semibold">رقم الموظف</label>
                            <input type="text" name="militaryNumber" x-model="currentEdit.number" required
                                   class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 font-mono focus:border-blue-500 focus:outline-none" />
                        </div>
                        <div>
                            <label class="block text-slate-700 mb-1 font-semibold">نوع الموظف</label>
                            <select name="soldierTypeId" x-model="currentEdit.typeId" required
                                    class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 focus:border-blue-500 focus:outline-none">
                                @foreach (var t in types)
                                {
                                    <option value="@t.Id">@t.Name</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="block text-slate-700 mb-1 font-semibold">تاريخ التسريح</label>
                            <input type="date" name="serviceEndDate" x-model="currentEdit.endDate" required
                                   class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 font-mono focus:border-blue-500 focus:outline-none" />
                        </div>
                        <div class="pt-3 border-t border-slate-200 flex justify-end gap-2">
                            <button type="button" @@click="editModalOpen = false" class="px-3.5 py-1.5 rounded-lg bg-slate-100 text-slate-700">إلغاء</button>
                            <button type="submit" class="px-4 py-1.5 rounded-lg font-bold bg-[#205493] text-white hover:bg-[#1f4e79] text-white">حفظ التعديلات</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
